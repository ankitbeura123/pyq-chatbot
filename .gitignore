# Virtual environment & Python cache
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables
.env

# Database & Storage (db.sqlite3 and chroma_db/ are tracked as seed data for deployment)
db.sqlite3.backup
*.backup
media/
staticfiles/

# Temporary generated files (PDFs, Notes, Mocks)
mock_papers/
revision_notes/
*.pdf
*.png
*.jpg
*.jpeg
*.log
!docs/screenshots/*.png
!docs/screenshots/*.jpg
!frontend/src/assets/*
!frontend/dist/assets/*

# Frontend dependencies (pre-compiled frontend/dist/ is tracked for deployment)
node_modules/
frontend/node_modules/

# OS artifacts
.DS_Store
Thumbs.db
